{
  "name": "cloudsail-zammad-skin",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker that skins Zammad's agent ticket view as a chat (support.cloudsail.uk).",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8080 --upstream-protocol http --port 8787",
    "deploy": "wrangler deploy",
    "deploy:legacy": "wrangler deploy --config wrangler.legacy.toml",
    "check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test test/worker.test.mjs",
    "seed": "node test/seed.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
