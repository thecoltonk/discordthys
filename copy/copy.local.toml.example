# Cloudsail Support: local copy overrides.
#
# Copy this file to copy/copy.local.toml (gitignored) and uncomment ONLY the keys
# you want to change. Every key in copy.local.toml overrides copy/copy.toml;
# anything left commented out keeps its default. It reloads live and is
# validated the same way: a bad edit is logged and ignored.
#
# Every key is listed below with its default value, grouped by section.
# {placeholders} are filled in by the bot; each key lists the ones it accepts.
# Use {{ and }} for literal braces. Colors are hex (#5865F2); "" means "none".
# Keep the [section] headers uncommented.
#
# Regenerate with:
#   python -m nephthys.core.copytext --example > copy/copy.local.toml.example


[community]
# #community-help messages players see.
# Posted in each new ticket thread when FAQ_URL is set.
# Placeholders: {faq_url}
# auto_reply = "someone should be along to help you soon! in the meantime check out the [FAQ]({faq_url}). once your question is answered, hit the button below to mark it as resolved :D"
# Posted in each new ticket thread when FAQ_URL is unset.
# auto_reply_no_faq = "someone should be along to help you soon! once your question is answered, hit the button below to mark it as resolved :D"
# Button label.
# resolve_button = "Mark as resolved"
# Button emoji: Unicode, or <:name:id> for a custom one ("" = none).
# resolve_button_emoji = "✅"
# Button label.
# reopen_button = "Re-open"
# Button emoji: Unicode, or <:name:id> for a custom one ("" = none).
# reopen_button_emoji = "🔄"
# Closing message ({user} is a mention that doesn't ping).
# Placeholders: {user}
# resolved = "marked as resolved by {user} — got another question? make a new post!"
# Closing message for automatic stale closes.
# Placeholders: {days}
# resolved_stale = "closing this one since it's been quiet for {days} days — got another question? make a new post!"
# Posted when a ticket is re-opened (button, /reopen or the poster replying).
# Placeholders: {user}
# reopened = "re-opened by {user}! someone will be along to help soon."
# Thread name when the question has no text (e.g. only an image).
# Placeholders: {name}
# thread_name_fallback = "Question from {name}"
# Private reply when a button fails unexpectedly.
# something_went_wrong = "something went wrong there — staff have been told!"

[errors]
# Private (ephemeral) refusals.
# not_allowed = "only the person who asked or a staff member can do that, sorry!"
# already_resolved = "this ticket is already resolved!"
# not_resolved = "this ticket isn't resolved, so there's nothing to re-open."
# ticket_missing = "i couldn't find a ticket for this thread."
# staff_only = "this command is for staff only."
# not_a_ticket_thread = "use this inside a ticket thread."

[commands]
# Staff slash commands: /faq, /ip, /resolve, /reopen, /waiting.
# Posted publicly by /faq.
# Placeholders: {faq_url}
# faq_reply = "check out the FAQ, it might have your answer: {faq_url}"
# Private reply to /faq when FAQ_URL is unset.
# faq_unconfigured = "no FAQ configured."
# Posted publicly by /ip.
# Placeholders: {server_address}
# ip_reply = "the server address is **{server_address}** — see you in game!"
# ip_unconfigured = "the server address hasn't been set up yet (SERVER_ADDRESS)."
# Private reply to /resolve.
# resolved = "resolved ✅"
# Private reply to /reopen.
# reopened = "re-opened 🔄"
# waiting_empty = "nothing waiting — nice work, team!"
# One line per waiting ticket. {ref} is #<id> or T-<number>; {last_message} is a relative time.
# Placeholders: {id}, {last_message}, {link}, {ref}, {title}
# waiting_line = "• [{ref} {title}]({link}) — last message {last_message}"
# Placeholders: {limit}
# waiting_more = "_…and more. Showing the oldest {limit}._"

[card]
# Staff ticket cards in STAFF_CHANNEL_ID.
# untitled = "Untitled question"
# no_text = "*(no text — see the thread)*"
# Stands in for an unknown user.
# someone = "someone"
# field_asked_by = "Asked by"
# Placeholders: {past_tickets}, {user}
# asked_by = "{user} · {past_tickets}"
# first_ticket = "first ticket"
# Placeholders: {count}
# past_tickets_one = "{count} past ticket"
# Placeholders: {count}
# past_tickets_many = "{count} past tickets"
# field_status = "Status"
# Placeholders: {reopened}
# status_waiting = "🟡 Waiting for staff{reopened}"
# Placeholders: {claimer}, {reopened}
# status_claimed = "🔵 Claimed by {claimer}{reopened}"
# Placeholders: {by}, {credit}
# status_resolved = "✅ Resolved {by}{credit}"
# Placeholders: {user}
# resolved_by = "by {user}"
# resolved_automatically = "automatically (stale)"
# Placeholders: {user}
# credit = " · credit {user}"
# no_credit = " · no staff credit"
# reopened_suffix = " (re-opened)"
# field_category = "Category"
# category_none = "—"
# A category picked by Jev.
# Placeholders: {category}
# category_ai = "{category} (AI)"
# Card link button to the ticket's Discord thread.
# open_thread_button = "Open in Discord"
# Button emoji: Unicode, or <:name:id> for a custom one ("" = none).
# open_thread_button_emoji = "🧵"
# #tickets card link button to the Zammad ticket (shown once the ticket is mirrored, when ZAMMAD_PUBLIC_URL is set).
# open_zammad_button = "Open in Zammad"
# Button emoji: Unicode, or <:name:id> for a custom one ("" = none).
# open_zammad_button_emoji = "🎫"
# category_pending = "category not picked yet"
# awaiting_first_message = "*(waiting for the player's first message)*"
# field_priority = "Priority"
# field_escalated = "Escalated from"
# Placeholders: {id}, {link}
# escalated_value = "[#{id}]({link})"
# field_escalated_to = "Escalated to"
# Placeholders: {link}, {number}
# escalated_to_value = "[T-{number}]({link})"
# A Zammad agent, where the card would mention a Discord user.
# Placeholders: {name}
# zammad_agent = "{name} (Zammad)"

[stats]
# Shared by /stats and the daily summary.
# surface_community = "#community-help"
# surface_tickets = "#tickets"
# field_opened = "Opened"
# Tickets claimed by staff in the period (first staff reply).
# field_claimed = "Claimed"
# field_resolved = "Resolved"
# Placeholders: {resolved}, {without_staff}
# resolved_value = "{resolved} ({without_staff} without staff)"
# field_median = "Median first staff response"
# field_open_now = "Open (unclaimed) now"
# field_in_progress = "In progress now"
# Placeholders: {days}
# field_waiting = "Waiting > {days} days"
# field_by_category = "Opened by category"
# uncategorised = "Uncategorised"
# field_by_priority = "By priority"
# priority_unset = "not picked yet"
# field_top_helpers = "Top helpers (resolved, by claimer)"
# Placeholders: {count}, {rank}, {user}
# leaderboard_line = "{rank}. {user} — {count}"
# leaderboard_empty = "nobody yet"
# field_zammad = "Zammad sync"
# zammad_ok = "✅ in sync"
# Shown in /stats while the Zammad sync has a backlog or failures.
# Placeholders: {failed}, {oldest}, {pending}
# zammad_backlog = "⚠️ {pending} queued (oldest {oldest}) · {failed} failed"
# not_available = "n/a"
# Placeholders: {n}
# minutes = "{n} min"
# Placeholders: {n}
# hours = "{n} h"
# Placeholders: {n}
# days = "{n} days"

[summary]
# The daily summary post.
# field_by_category = "By category"
# Placeholders: {count}, {days}
# field_waiting = "Waiting > {days} days ({count})"
# waiting_none = "none 🎉"
# Placeholders: {id}, {last_message}, {link}, {ref}, {title}
# waiting_line = "• [{ref} {title}]({link}) — {last_message}"
# Placeholders: {count}
# waiting_more = "…and {count} more (see /waiting)"

[faq]
# The FAQ matcher. The answers themselves are the files in kb/, posted word
# for word; this is only the text around them.
# Reply to a question in a watched channel (FAQ_WATCH_CHANNEL_IDS): {answer} is the FAQ entry's answer, word for word; {channel} is #community-help.
# Placeholders: {answer}, {channel}
# watch_reply = '''
# {answer}
#
# -# got another question? ask in {channel}'''
# Reply to a support question in a watched channel that no FAQ entry answers (only with FAQ_WATCH_POINTER=true).
# Placeholders: {channel}
# watch_pointer = "that sounds like one for {channel} — post it there and someone will help you out!"
# Private reply to a click on a button of the removed AI assistant.
# retired_button = "that button belonged to the old AI assistant, which has been removed."
# shadow_field_confidence = "Confidence"
# shadow_field_where = "Where"
# shadow_field_question = "Message"
# shadow_no_text = "*(no text)*"
# Placeholders: {id}, {link}
# shadow_where_ticket = "new ticket [#{id}]({link})"
# Placeholders: {channel}, {link}
# shadow_where_channel = "{channel} · [message]({link})"
# Watched channels: both of Jev's confidence scores.
# Placeholders: {match}, {question}
# shadow_confidence_watch = "match {match} · real question {question}"
# Placeholders: {question}
# shadow_confidence_pointer = "support question {question} · no FAQ match"
# Stands in for the entry id when only the pointer would be sent.
# shadow_pointer_name = "pointer to #community-help"

[tickets]
# #tickets: the panel, private ticket threads, closing and escalation.
# create_button = "Create Ticket"
# Button emoji: Unicode, or <:name:id> for a custom one ("" = none).
# create_button_emoji = "🎫"
# Private thread name (max 100 characters; longer is cut).
# Placeholders: {name}, {number}
# thread_name = "{name} (T-{number})"
# Placeholders: {number}
# opener_header = "## Ticket T-{number}"
# Shown at the top of every new ticket.
# Placeholders: {user}
# welcome = "Hey {user}, thanks for reaching out! Pick the option below that best fits what you need help with."
# Added to tickets created with /escalate.
# Placeholders: {link}
# escalated_note = "This ticket was moved here from {link} so we can help you privately."
# One line per pick; the lines stack up.
# Placeholders: {choice}
# selected = "You have selected: **{choice}**"
# close_button = "Close Ticket"
# Button emoji: Unicode, or <:name:id> for a custom one ("" = none).
# close_button_emoji = ""
# Private reply to Create Ticket.
# Placeholders: {link}
# created = "your ticket is ready: {link}"
# Private reply when TICKETS_MAX_OPEN_PER_USER is reached.
# Placeholders: {count}, {links}
# too_many_open = "you already have {count} open ticket(s): {links} — please use one of those, or close one first."
# create_failed = "sorry, i couldn't open a ticket right now. please try again in a minute, or ask in #community-help."
# not_your_ticket = "only the person who opened this ticket or staff can do that."
# already_picked = "that's already been chosen!"
# option_gone = "that option isn't available anymore — please ask staff."
# Posted when a ticket is closed (button or /resolve).
# Placeholders: {user}
# closed = "this ticket has been closed by {user}. thanks for reaching out!"
# Private reply to /reopen inside a #tickets thread.
# no_reopen = "closed tickets can't be re-opened. if there's more to sort out, the player can open a new ticket in #tickets."
# Private reply to a click on a rating button left in a thread from before ratings were removed.
# csat_retired = "we're no longer collecting ratings here — thanks anyway!"
# priority_low = "🟢 Low"
# priority_medium = "🟡 Medium"
# priority_high = "🔴 High"
# Posted in the #community-help thread by /escalate before locking it.
# Placeholders: {link}, {user}
# escalated_public = "this has been moved to a private ticket ({link}) so staff can help {user} privately. 🔒"
# Copy of the public question, when /escalate deletes the original.
# Placeholders: {quote}
# escalated_quote = '''
# **Original message:**
# {quote}'''
# Placeholders: {link}
# escalate_done = "escalated to {link}"
# Placeholders: {link}
# already_escalated = "this was already escalated: {link}"
# not_community_thread = "use this inside a #community-help ticket thread."
# tickets_disabled = "#tickets isn't set up (TICKETS_CHANNEL_ID)."

[zammad]
# Zammad replies posted into #tickets threads.
# The webhook display name on an agent's reply; {name} is their Zammad display name. Discord allows 80 characters: a long {name} is shortened so the rest still fits. "discord", "clyde", @ # : and ``` are removed (Discord refuses them).
# Placeholders: {name}
# agent_name = "{name} (Support)"
# The whole display name when an agent has no usable name.
# unknown_agent = "Support"
# Plain bot message used when the reply can't be posted under the agent's name.
# Placeholders: {name}, {text}
# fallback_reply = "**{name} (Support):** {text}"
# Added when an agent's attachment is too large or unavailable.
# Placeholders: {filename}
# attachment_skipped = "📎 *{filename} couldn't be attached here.*"

[embeds.sticky]
# The "how it works" sticky at the bottom of #community-help.
# title = "How #community-help works"
# Used when FAQ_URL is set.
# Placeholders: {faq_url}
# description = '''
# **Post your question as a new message in this channel** and a thread will be opened for it. Anyone can help out, and staff will be along soon!
#
# • Keep all follow-ups inside your thread.
# • Once you're sorted, hit **Mark as resolved** in your thread.
# • Got a new question later? Just post a new message.
#
# Before posting, check the FAQ: {faq_url}'''
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#5865F2"
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""
# Used when FAQ_URL is unset.
# description_no_faq = '''
# **Post your question as a new message in this channel** and a thread will be opened for it. Anyone can help out, and staff will be along soon!
#
# • Keep all follow-ups inside your thread.
# • Once you're sorted, hit **Mark as resolved** in your thread.
# • Got a new question later? Just post a new message.'''

[embeds.tickets_panel]
# The sticky "Need help?" panel in #tickets.
# title = "Need help?"
# Placeholders: {community_channel}
# description = "First, check the known issues and see if {community_channel} can sort it. If not, hit the button below to open a private thread with the team."
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#5865F2"
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""

[embeds.ticket_opener]
# The #tickets opener. Off by default (plain text, as before); set enabled = true
# to send it as an embed. {body} is the welcome, picks and blurb.
# Placeholders: {number}
# title = "Ticket T-{number}"
# Placeholders: {body}
# description = "{body}"
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#5865F2"
# Placeholders: {number}
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""
# true = send as an embed; false = plain text.
# enabled = false

[embeds.ticket_closed]
# The #tickets closing message. Off by default (plain text); enabled = true sends
# it as an embed. {message} is [tickets] closed.
# title = ""
# Placeholders: {message}
# description = "{message}"
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#2ECC71"
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""
# true = send as an embed; false = plain text.
# enabled = false

[embeds.staff_card]
# Staff ticket cards (both channels). The colour follows the ticket status.
# #community-help cards.
# Placeholders: {id}, {title}
# title = "#{id} · {title}"
# Placeholders: {question}
# description = "{question}"
# Hex colour like #5865F2 (empty = none).
# color = ""
# {ref} is T-<number> for #tickets (#<id> on old #community-help cards).
# Placeholders: {id}, {ref}
# footer = "Ticket {ref}"
# Optional image URL (https://...).
# thumbnail_url = ""
# #tickets cards.
# Placeholders: {category}, {number}
# private_title = "T-{number} · {category}"
# Hex colour, e.g. #5865F2 ("" = none).
# color_waiting = "#F1C40F"
# Hex colour, e.g. #5865F2 ("" = none).
# color_claimed = "#5865F2"
# Hex colour, e.g. #5865F2 ("" = none).
# color_resolved = "#2ECC71"

[embeds.daily_summary]
# The daily summary (one embed per channel).
# Placeholders: {surface}
# title = "📊 {surface} daily summary"
# Placeholders: {since}, {until}
# description = "{since} → {until}"
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#5865F2"
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""

[embeds.stats]
# /stats (one embed per channel).
# Placeholders: {days}, {surface}
# title = "{surface} — last {days} days"
# Placeholders: {days}, {surface}
# description = ""
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#5865F2"
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""
# Placeholders: {surface}
# title_one_day = "{surface} — last 1 day"

[embeds.waiting]
# /waiting. {lines} is the list of tickets.
# title = "Waiting for staff"
# Placeholders: {lines}
# description = "{lines}"
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#E67E22"
# footer = ""
# Optional image URL (https://...).
# thumbnail_url = ""

[embeds.faq_shadow]
# Shadow mode: what the FAQ matcher would have posted, shown to staff only.
# {entry} is the FAQ entry's id; {text} is the exact text players would get.
# Placeholders: {entry}
# title = "FAQ match (shadow) · {entry}"
# Placeholders: {text}
# description = "{text}"
# Hex colour, e.g. #5865F2 ("" = none).
# color = "#11806A"
# footer = "Not shown to the player. Set FAQ_MODE=public to post these."
# Optional image URL (https://...).
# thumbnail_url = ""
