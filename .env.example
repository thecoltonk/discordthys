# Cloudsail Support configuration.
# Copy to `.env` and fill in. Blank optional values use the default shown.
# To get Discord IDs: User Settings → Advanced → Developer Mode, then right-click → Copy ID.

# --- Required -----------------------------------------------------------------

# Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=
# Your server (guild) ID. Slash commands are registered here.
GUILD_ID=
# The #community-help TEXT channel
COMMUNITY_CHANNEL_ID=
# The Staff role. Members with it claim tickets by replying, and can resolve, re-open and use the staff slash commands.
STAFF_ROLE_ID=
# Postgres connection string. In docker-compose this is built from the POSTGRES_* values below.
DATABASE_URL=postgresql://cloudsail:change-me@localhost:5432/cloudsail_support

# --- Optional channels / people ------------------------------------------------

# Staff channel: #tickets alert cards (with role pings), AI shadow suggestions and the daily summary (blank = none of these).
# #community-help tickets get no card here; they're counted in /stats, /waiting and the summary.
STAFF_CHANNEL_ID=
# Log channel for bot errors and notable events (blank = stderr only).
# Only real errors notify; everything else is posted @silent.
LOG_CHANNEL_ID=
# Discord user ID pinged in the log channel when something breaks
MAINTAINER_ID=
# Post "Cloudsail Support is online" to the log channel at startup (@silent)
LOG_STARTUP_NOTICE=false

# --- Behaviour -------------------------------------------------------------------

# Linked by the auto-reply, the sticky and /faq. Leave blank to drop the FAQ sentence everywhere.
FAQ_URL=https://cloudsail.uk/faq
# Posted by /ip
SERVER_ADDRESS=play.cloudsail.uk
# Reaction on open questions; set to empty to disable. Default 🤔
OPEN_REACTION=🤔
# Reaction on resolved questions. Default ✅
RESOLVED_REACTION=✅
# Thread inactivity auto-archive: 60, 1440, 4320 or 10080 minutes. Default 10080 (1 week)
THREAD_AUTO_ARCHIVE_MINUTES=10080
# Auto-resolve tickets with no activity for this many days (blank = disabled)
STALE_TICKET_DAYS=
# Sticky "how it works" message at the bottom of #community-help
STICKY_ENABLED=true
# Wait this many seconds after the last new question before reposting the sticky
STICKY_DEBOUNCE_SECONDS=5
# All message text (auto-reply, closing messages, sticky, cards, command replies, ...)
# lives in copy/copy.toml. It's reloaded automatically when the file changes.
COPY_FILE=copy/copy.toml
# Optional local overrides on top of COPY_FILE (gitignored). Any key in it wins; missing keys
# fall back. Same live reload + validation. Start from copy/copy.local.toml.example.
COPY_OVERRIDE_FILE=copy/copy.local.toml

# --- #tickets (private, Mava-style tickets) ---------------------------------------

# The #tickets TEXT channel (blank = #tickets disabled). See DEPLOY.md for its permissions.
TICKETS_CHANNEL_ID=
# Roles pinged for categories owned by "store" / "mod" (blank = ping the Staff role instead)
STORE_ROLE_ID=
MOD_ROLE_ID=
# First ticket number: T-26 by default (Mava ended at T-25). Never moves backwards.
TICKET_NUMBER_START=26
# Max open #tickets tickets per player (0 = unlimited)
TICKETS_MAX_OPEN_PER_USER=2
# Closed tickets: lock the thread right away so the player can't post (they can still rate)
TICKETS_LOCK_ON_CLOSE=true
# Archive a closed ticket when the player rates it, or after this many hours without a rating
CSAT_TIMEOUT_HOURS=24
# Categories, subcategories, priorities, owning roles and blurbs (read at startup)
TICKET_CATEGORIES_FILE=copy/ticket_categories.toml
# Timezone for the stale auto-close job
TIMEZONE=Europe/London

# --- Zammad two-way sync for #tickets (optional) ----------------------------------
# Off unless ZAMMAD_URL and ZAMMAD_TOKEN are both set. Needs #tickets. Setup: DEPLOY.md §7.

# Zammad as the bot reaches it over Zammad's Docker network (docker-compose.zammad.yml)
ZAMMAD_URL=http://zammad-nginx:8080
# API token of the bot's own Zammad agent user, with only the "ticket.agent" permission
ZAMMAD_TOKEN=
# Admin token used only by `nephthys zammad-setup` (admin.object, admin.webhook, admin.trigger,
# admin.group, admin.channel_email). Remove it again after setup. Blank = use ZAMMAD_TOKEN.
ZAMMAD_SETUP_TOKEN=
# Optional: puts each player's Discord profile picture on their Zammad customer.
# Must belong to a SEPARATE Zammad user whose only role grants admin.user (the
# minimum Zammad accepts for acting "From" a customer). See DEPLOY.md §7.1 step 5.
# Blank = names are kept in sync, pictures aren't.
ZAMMAD_AVATAR_TOKEN=
# Signs Zammad's webhook calls to the bot (required when the sync is on, 16+ characters).
# Generate one with:  openssl rand -hex 32
ZAMMAD_WEBHOOK_SECRET=
# Zammad as browsers reach it: ticket links on staff cards and agent avatars
ZAMMAD_PUBLIC_URL=https://support.cloudsail.uk
# Avatar for agents without a picture, or when ZAMMAD_PUBLIC_URL is blank (any public image URL)
ZAMMAD_DEFAULT_AVATAR_URL=
# Where Zammad calls the bot. The default matches docker-compose.zammad.yml.
ZAMMAD_WEBHOOK_URL=http://cloudsail-support-bot:3000/zammad/webhook
# Name of Zammad's Docker network (docker-compose.zammad.yml):  docker network ls | grep zammad
ZAMMAD_DOCKER_NETWORK=zammad-docker-compose_default
# Attachments larger than this many MB are mentioned by name instead of copied (either direction)
ZAMMAD_ATTACHMENT_MAX_MB=10
# Per-request timeout for Zammad API calls, in seconds
ZAMMAD_TIMEOUT_SECONDS=20
# Give up on a queued item after this many failed attempts (backoff 5s → 15 min; 25 ≈ 5 hours)
ZAMMAD_OUTBOX_MAX_ATTEMPTS=25
# Every N minutes, check Zammad for replies or state changes a webhook didn't deliver (0 = off)
ZAMMAD_RECONCILE_MINUTES=5

# --- Categories --------------------------------------------------------------------

# #community-help categories (comma-separated, max 25): AI auto-categorisation and stats.
# #tickets categories are separate: copy/ticket_categories.toml
TICKET_CATEGORIES=Gameplay,Bug,Claims,Economy,Store,Other

# --- Daily summary -------------------------------------------------------------------

# Post a daily summary to STAFF_CHANNEL_ID (needs STAFF_CHANNEL_ID)
DAILY_SUMMARY_ENABLED=true
# When to post it (24h HH:MM) and in which timezone
DAILY_SUMMARY_TIME=09:00
DAILY_SUMMARY_TIMEZONE=America/Phoenix

# --- AI (optional: everything AI is off while AI_API_KEY is blank) --------------------

# OpenAI-compatible API. The default is Hack Club AI.
AI_API_KEY=
AI_BASE_URL=https://ai.hackclub.com/proxy/v1
# Required when AI_API_KEY is set: a model ID your provider serves
AI_MODEL=
# Auto-categorise new tickets (the card shows "(AI)" until staff change it)
AI_CATEGORIZE=true
# Knowledge-base answers:
#   off    = no answers
#   shadow = suggestions go only to the staff channel, with 👍/👎 buttons (default)
#   public = a labelled bot answer in the thread, with "This fixed it" / "I still need a human"
AI_ANSWER_MODE=shadow
# Only post answers at or above this confidence (0-1). Answers must also cite kb/ files.
AI_ANSWER_MIN_CONFIDENCE=0.8
# Request timeout in seconds
AI_TIMEOUT_SECONDS=30
# Folder of markdown files the assistant may use. In Docker, ./kb is mounted here read-only.
KB_DIR=kb

# --- Runtime ---------------------------------------------------------------------

# development | production
ENVIRONMENT=production
# Port for /health and /metrics
PORT=3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Run database migrations on container start (entrypoint.sh)
RUN_MIGRATIONS=true

# Optional OpenTelemetry log export
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_BASIC_AUTH=
OTEL_SERVICE_NAME=cloudsail-support
LOG_LEVEL_OTEL=INFO

# --- docker-compose only ------------------------------------------------------------
# To run with the Zammad sync, include the overlay (see docker-compose.zammad.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.zammad.yml
POSTGRES_USER=cloudsail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloudsail_support
